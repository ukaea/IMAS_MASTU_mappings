{
    "ids_properties/homogeneous_time": 0,
    "loop": "{{ length(LOOPS) }}",
    "loop[#]/name": "{{ PASSIVE_NAME }}",
    "loop[#]/resistance": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "GEOMETRY",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "resistance"
        }
    },
    "loop[#]/resistivity": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "GEOMETRY",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "resistivity"
        }
    },
    "loop[#]/current": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "UDA",
        "ARGS": {
            "signal": "{{ PASSIVE_CURRENT }}"
        },
        "SCALE": "{{ UNIT_SF }}"
    },
    "loop[#]/time": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "UDA",
        "ARGS": {
            "signal": "{{ PASSIVE_CURRENT }}",
            "time": true
        }
    },
    "loop[#]/element": {
        "MAP_TYPE": "DIMENSION",
        "DIM_PROBE": "_loop[#]/element[#]/n_elements"
    },
    "_loop[#]/element[#]/n_elements": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "GEOMETRY",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "centreR"
        }
    },
    "loop[#]/element[#]/name": "{{ PASSIVE_NAME }}_E{{ #1 + 1 }}",
    "loop[#]/element[#]/identifier": "{{ PASSIVE_NAME }}_L{{ #0 + 1 }}_E{{ #1 + 1 }}",
    "loop[#]/element[#]/geometry/geometry_type": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "CUSTOM_MASTU",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "geometry_type",
            "element": "{{ #1 }}",
            "function": "custom_passive_structures"
        }
    },
    "loop[#]/element[#]/geometry/rectangle/r": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "CUSTOM_MASTU",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "rectangle.centreR",
            "element": "{{ #1 }}",
            "function": "custom_passive_structures"
        }
    },
    "loop[#]/element[#]/geometry/rectangle/z": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "CUSTOM_MASTU",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "rectangle.centreZ",
            "element": "{{ #1 }}",
            "function": "custom_passive_structures"
        }
    },
    "loop[#]/element[#]/geometry/rectangle/width": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "CUSTOM_MASTU",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "rectangle.dR",
            "element": "{{ #1 }}",
            "function": "custom_passive_structures"
        }
    },
    "loop[#]/element[#]/geometry/rectangle/height": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "CUSTOM_MASTU",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "rectangle.dZ",
            "element": "{{ #1 }}",
            "function": "custom_passive_structures"
        }
    },
    "loop[#]/element[#]/geometry/oblique/r": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "CUSTOM_MASTU",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "oblique.centreR",
            "element": "{{ #1 }}",
            "function": "custom_passive_structures"
        }
    },
    "loop[#]/element[#]/geometry/oblique/z": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "CUSTOM_MASTU",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "oblique.centreZ",
            "element": "{{ #1 }}",
            "function": "custom_passive_structures"
        }
    },
    "loop[#]/element[#]/geometry/oblique/length_alpha": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "CUSTOM_MASTU",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "oblique.dR",
            "element": "{{ #1 }}",
            "function": "custom_passive_structures"
        }
    },
    "loop[#]/element[#]/geometry/oblique/length_beta": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "CUSTOM_MASTU",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "oblique.dZ",
            "element": "{{ #1 }}",
            "function": "custom_passive_structures"
        }
    },
    "loop[#]/element[#]/geometry/oblique/alpha": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "CUSTOM_MASTU",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "oblique.shapeAngle1",
            "element": "{{ #1 }}",
            "function": "custom_passive_structures"
        }
    },
    "loop[#]/element[#]/geometry/oblique/beta": {
        "MAP_TYPE": "DATA_SOURCE",
        "DATA_SOURCE": "CUSTOM_MASTU",
        "ARGS": {
            "signal": "/passive/efit/{{ PASSIVE_NAME }}",
            "key": "oblique.shapeAngle2",
            "element": "{{ #1 }}",
            "function": "custom_passive_structures"
        }
    }
}
