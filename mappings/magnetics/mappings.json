{
    "ids_properties/homogeneous_time": 1,
    "ids_properties/version_put/data_dictionary": "3.42.0",
    "time": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/AMB/CTIME"
        }
    },
    "flux_loop": "{{ length(FLUX_LOOPS) }}",
    "flux_loop[#]/name": "{{ FL_NAME }}",
    "flux_loop[#]/identifier": "FLUX_LOOP_{{ #0 + 1 }}",
    "flux_loop[#]/type/name": "{{ FL_TYPE }}",
    "flux_loop[#]/type/index": "{{ FL_TYPE_MAP[FLUX_LOOPS[#0].TYPE] }}",
    "flux_loop[#]/position": {
        "map_type": "DIMENSION",
        "dim_probe": "_flux_loop[#]/position_size"
    },
    "_flux_loop[#]/position_size": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ FL_NAME }}",
            "key": "{{ FL_POSITION_MAP[FLUX_LOOPS[#0].TYPE] }}.r"
        }
    },
    "flux_loop[#]/position[#]/r": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ FL_NAME }}",
            "key": "{{ FL_POSITION_MAP[FLUX_LOOPS[#0].TYPE] }}.r"
        },
        "slice": "[{{ #1 }}]"
    },
    "flux_loop[#]/position[#]/z": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ FL_NAME }}",
            "key": "{{ FL_POSITION_MAP[FLUX_LOOPS[#0].TYPE] }}.z"
        },
        "slice": "[{{ #1 }}]"
    },
    "flux_loop[#]/position[#]/phi": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ FL_PHI }}",
            "key": "coilPath.phi"
        },
        "slice": "[{{ #1 }}]",
        "scale": "{{ DEG2RAD }}"
    },
    "flux_loop[#]/flux/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/AMB/{{ FL_TYPE }}/{{ FL_NAME }}"
        },
        "scale": -1
    },
    "flux_loop[#]/voltage/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/AMB/LOOPV/{{ LOOPV_NAME }}"
        }
    },
    "ip": 1,
    "ip[#]/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/AMC/PLASMA_CURRENT"
        },
        "scale": "{{ UNIT_SF }}"
    },
    "ip[#]/method_name": "IP Rogowski measurement",
    "b_field_pol_probe": "{{ length(BPOL_PROBES) }}",
    "b_field_pol_probe[#]/name": "{{ BPOL_NAME }}",
    "b_field_pol_probe[#]/identifier": "BPOL_PROBE_{{ #0 + 1 }}",
    "b_field_pol_probe[#]/type/name": "mirnov",
    "b_field_pol_probe[#]/type/index": 2,
    "b_field_pol_probe[#]/type/description": "Mirnov Probe",
    "b_field_pol_probe[#]/position/r": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "coordinate.r"
        }
    },
    "b_field_pol_probe[#]/position/z": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "coordinate.z"
        }
    },
    "b_field_pol_probe[#]/position/phi": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "coordinate.phi"
        },
        "scale": "{{ DEG2RAD }}"
    },
    "b_field_pol_probe[#]/area": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "geometry.areaAve"
        }
    },
    "b_field_pol_probe[#]/length": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "geometry.length"
        }
    },
    "b_field_pol_probe[#]/turns": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "geometry.nturnsTotal"
        }
    },
    "b_field_pol_probe[#]/field/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/AMB/PICKUP/{{ BPOL_NAME }}"
        }
    },
    "b_field_pol_probe[#]/poloidal_angle": {
        "map_type": "EXPR",
        "parameters": {
            "Z": "_temp/pickup[#]/unit_vector/z",
            "R": "_temp/pickup[#]/unit_vector/r"
        },
        "expr": "mod(2*PI-atan2(Z,R), 2*PI)"
    },
    "b_field_pol_probe[#]/toroidal_angle": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "orientation.unit_vector.phi"
        }
    },
    "_temp/pickup[#]/unit_vector/r": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "orientation.unit_vector.r"
        }
    },
    "_temp/pickup[#]/unit_vector/z": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPOL_NAME }}",
            "key": "orientation.unit_vector.z"
        }
    },
    "b_field_phi_probe": "{{ length(BPHI_PROBES) }}",
    "b_field_phi_probe[#]/name": "{{ BPHI_NAME }}",
    "b_field_phi_probe[#]/identifier": "BPHI_PROBE_{{ #0 + 1 }}",
    "b_field_phi_probe[#]/type/name": "mirnov",
    "b_field_phi_probe[#]/type/index": 2,
    "b_field_phi_probe[#]/type/description": "Mirnov Probe",
    "b_field_phi_probe[#]/position/r": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPHI_NAME }}",
            "key": "coordinate.r"
        }
    },
    "b_field_phi_probe[#]/position/z": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPHI_NAME }}",
            "key": "coordinate.z"
        }
    },
    "b_field_phi_probe[#]/position/phi": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPHI_NAME }}",
            "key": "coordinate.phi"
        },
        "scale": "{{ DEG2RAD }}"
    },
    "b_field_phi_probe[#]/area": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPHI_NAME }}",
            "key": "geometry.areaAve"
        }
    },
    "b_field_phi_probe[#]/length": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPHI_NAME }}",
            "key": "geometry.length"
        }
    },
    "b_field_phi_probe[#]/turns": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPHI_NAME }}",
            "key": "geometry.nturnsTotal"
        }
    },
    "b_field_phi_probe[#]/field/data": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/AMB/PICKUP/{{ BPHI_NAME }}"
        }
    },
    "b_field_phi_probe[#]/poloidal_angle": {
        "map_type": "EXPR",
        "parameters": {
            "Z": "_temp/pickup_phi[#]/unit_vector/z",
            "R": "_temp/pickup_phi[#]/unit_vector/r"
        },
        "expr": "mod(2*PI-atan2(Z,R), 2*PI)"
    },
    "b_field_phi_probe[#]/toroidal_angle": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPHI_NAME }}",
            "key": "orientation.unit_vector.phi"
        }
    },
    "_temp/pickup_phi[#]/unit_vector/r": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPHI_NAME }}",
            "key": "orientation.unit_vector.r"
        }
    },
    "_temp/pickup_phi[#]/unit_vector/z": {
        "map_type": "DATA_SOURCE",
        "data_source": "GEOMETRY",
        "args": {
            "signal": "{{ BPHI_NAME }}",
            "key": "orientation.unit_vector.z"
        }
    }
}
