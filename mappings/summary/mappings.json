    "global_quantities/beta_pol_mhd/value": {
        "map_type": "EXPR",
        "parameters": {
            "wplasma": "global_quantities/energy_mhd/value",
            "ip": "_epmcurrent/interp",
            "R0": "global_quantities/r0/value"
        },
        "expr": "4 * (wplasma / 1.5) / (R0 * {{MU0VAL}} * ip * ip)"
    },
    "global_quantities/beta_pol_mhd/source": "4 int(p dV) = (wplasma / 1.5). Therefore, betap = 4 * (wplasma / 1.5) / (R0 * MU0VAL * ip^2). ip=/EPM/OUTPUT/GLOBALPARAMETERS/PLASMACURRENT, r0=0.8, wplasma=/EPM/OUTPUT/GLOBALPARAMETERS/PLASMAENERGY",
