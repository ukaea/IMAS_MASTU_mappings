{
    "ids_properties/homogeneous_time": 0,
    "flux_control/i_plasma/reference": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/XDC/PLASMA/T/IP_REF"
        },
        "scale": "{{ UNIT_SF }}"
    },
    "flux_control/mode": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/XDC/PLASMA/T/OHMIC_BLENDER"
        }
    },
    "flux_control/loop_voltage/reference": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/XDC/PLASMA/T/VLOOP_REF"
        }
    },
    "pf_active/coil": "{{ length(PF_SUPPLIES) }}",
    "pf_active/coil[#]/name": "{{ SUPPLY_NAME }}",
    "pf_active/coil[#]/identifier": "COIL_{{ indices.0 + 1 }}",
    "pf_active/coil[#]/current/reference": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/XDC/CIRCUITS/T/{{ SUPPLY_NAME }}REF"
        },
        "comment": "Not complete timebase"
    },
    "pf_active/supply": "{{ length(PF_SUPPLIES) }}",
    "pf_active/supply[#]/name": "{{ SUPPLY_NAME }}",
    "pf_active/supply[#]/identifier": "SUPPLY_{{ indices.0 + 1 }}",
    "pf_active/supply[#]/voltage/reference": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/XDC/PF/F/{{ SUPPLY_NAME }}"
        }
    },
    "density_control/n_e_line/reference": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/XDC/FUELLING/T/DENSITY_REF_TARGET"
        }
    },
    "position_control/x_point": 1,
    "position_control/x_point[#]/r/reference": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/XDC/SHAPE/T/RX_REF"
        }
    },
    "position_control/x_point[#]/z/reference": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/XDC/SHAPE/T/ZX_REF"
        }
    },
    "position_control/gap": "{{ length(GAP_R) }}",
    "position_control/gap[#]/z": 0.0,
    "position_control/gap[#]/angle": 0.0,
    "position_control/gap[#]/r": "{{ at(GAP_R, indices.0) }}",
    "position_control/gap[#]/value/reference": {
        "map_type": "DATA_SOURCE",
        "data_source": "UDA",
        "args": {
            "signal": "/XDC/SHAPE/T/{{ at(GAP_R_REF, indices.0) }}"
        }
    }
}
